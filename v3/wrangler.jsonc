{
  "name": "indomito-web",
  "compatibility_date": "2026-09-25",
  "routes": [
    { "pattern": "www.indomitocafe.com", "custom_domain": true },
    { "pattern": "indomitocafe.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

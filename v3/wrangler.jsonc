{
  "name": "indomito-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "routes": [
    { "pattern": "www.indomitocafe.com", "custom_domain": true },
    { "pattern": "indomitocafe.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Solo /api/* pasa por el Worker; el resto lo sirven los assets directo (sin costo de invocación).
    "run_worker_first": ["/api/*"]
  },
  // Postulaciones (§26 del HANDOFF). El token de Airtable y el secret de Turnstile van como secrets:
  //   npx wrangler secret put AIRTABLE_TOKEN
  //   npx wrangler secret put TURNSTILE_SECRET
  "vars": {
    "AIRTABLE_BASE": "appNmepcR3NLbZtCH",
    "AIRTABLE_TABLE": "Postulantes",
    // Panel /postulantes/ (§26.4 del HANDOFF). Vacíos = el panel responde 403 (falla cerrado).
    // ACCESS_TEAM_DOMAIN: https://<equipo>.cloudflareaccess.com · ACCESS_AUD: "Application Audience (AUD) Tag" de la app de Access.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "soyjorferraro@gmail.com"
  },
  "observability": { "enabled": true }
}
